#!/bin/zsh

DIANE_DIR="$(dirname "$0")"
CURRENT_DIR="$(pwd)"

DIANE_CONFIG="${DIANE_CONFIG:-$HOME/.config/diane/config.txt}"
if [ -f "$DIANE_CONFIG" ]; then
    # shellcheck source=/dev/null
    source "$DIANE_CONFIG"
fi
TRANSCRIPT_FILE="$CURRENT_DIR/transcriptions.md"
NOTES_FILE="$CURRENT_DIR/notes.md"

MODEL="sonnet"
EFFORT="medium"
WHISPER_MODEL=""
WHISPER_MAX_CONTEXT=""
DELETE_TRANSCRIPTIONS=false

usage() {
    echo "Usage: Diane [-m model] [-e effort] [-w whisper-model] [-d] [-h] [instruction]"
    echo ""
    echo "Transcribes audio files in the current directory and organizes them into notes.md."
    echo ""
    echo "Options:"
    echo "  -m <model>   Claude model to use (default: sonnet)"
    echo "               Aliases: sonnet, opus, haiku"
    echo "               Full IDs: claude-sonnet-4-6, claude-opus-4-7, etc."
    echo "  -e <level>   Thinking effort: low, medium, high, xhigh, max (default: medium)"
    echo "  -w <model>   Whisper model to use (default: from config, or medium.en)"
    echo "               Examples: tiny.en, base.en, small.en, medium.en, large-v3"
    echo "  -mc <n>      Max context tokens from previous segment (default: 0, reduces hallucinations)"
    echo "  -d           Delete transcriptions.md after notes.md is written"
    echo "  -h           Show this help message"
    echo ""
    echo "Arguments:"
    echo "  instruction  Optional note to Diane about how to handle this session"
    echo ""
    echo "Examples:"
    echo "  Diane"
    echo "  Diane \"These are just test files\""
    echo "  Diane -e high"
    echo "  Diane -m opus -e high \"Focus on the weather data\""
    echo "  Diane -w large-v3 \"Speaker has a strong accent\""
    echo "  Diane -d"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m)  MODEL="$2";               shift 2 ;;
        -e)  EFFORT="$2";              shift 2 ;;
        -w)  WHISPER_MODEL="$2";       shift 2 ;;
        -mc) WHISPER_MAX_CONTEXT="$2"; shift 2 ;;
        -d)  DELETE_TRANSCRIPTIONS=true; shift ;;
        -h)  usage ;;
        -*)  usage ;;
        *)   break ;;
    esac
done

USER_INSTRUCTION="$1"

if [ -f "$NOTES_FILE" ]; then
    echo "Error: notes.md already exists in this directory. Remove it first if you want to re-run Diane."
    exit 1
fi

# Transcribe all audio files in the current directory (whisper-dir skips already-transcribed files)
WHISPER_ARGS=("$CURRENT_DIR")
[ -n "$WHISPER_MODEL" ] && WHISPER_ARGS=(-m "$WHISPER_MODEL" "${WHISPER_ARGS[@]}")
[ -n "$WHISPER_MAX_CONTEXT" ] && WHISPER_ARGS=(-mc "$WHISPER_MAX_CONTEXT" "${WHISPER_ARGS[@]}")
"$DIANE_DIR/whisper-dir.sh" "${WHISPER_ARGS[@]}"

if [ ! -s "$TRANSCRIPT_FILE" ]; then
    echo "No audio files found or transcription produced nothing."
    exit 1
fi

echo "Sending transcription to Diane..."

PROMPT="$(cat "$TRANSCRIPT_FILE")"
if [ -n "$USER_INSTRUCTION" ]; then
    PROMPT="$PROMPT

---
Special instruction from the researcher: $USER_INSTRUCTION"
fi

claude -p "$PROMPT" \
    --model "$MODEL" \
    --effort "$EFFORT" \
    --system-prompt "$(cat "$DIANE_DIR/DIANE.md")" \
    --tools "" \
    > "$NOTES_FILE"

echo "Notes written to: $NOTES_FILE"

if [ "$DELETE_TRANSCRIPTIONS" = true ]; then
    rm "$TRANSCRIPT_FILE"
    echo "Deleted transcriptions.md"
fi
