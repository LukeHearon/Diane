#!/bin/zsh

DIANE_DIR="$(dirname "$0")"

usage() {
    echo "Usage: Diane <action> [options] [instruction]"
    echo ""
    echo "Actions:"
    echo "  notes      Transcribe audio files and organize into notes.md"
    echo "  metadata   Extract recorder deployment metadata into metadata.csv"
    echo ""
    echo "Run 'Diane notes -h' or 'Diane metadata -h' for action-specific options."
    exit 0
}

ACTION="${1:-}"
shift 2>/dev/null

case "$ACTION" in
    notes)    exec "$DIANE_DIR/lib/notes.sh"    "$@" ;;
    metadata) exec "$DIANE_DIR/lib/metadata.sh" "$@" ;;
    -h|--help|help) usage ;;
    "") usage ;;
    *) echo "Unknown action: $ACTION"; usage ;;
esac
